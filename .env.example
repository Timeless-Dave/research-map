# Copy to .env.local and fill in values. Never commit real keys.

# MapTiler — basemap + satellite tiles (https://cloud.maptiler.com)
NEXT_PUBLIC_MAPTILER_KEY=

# Experimental illustration: off until visual/device acceptance is complete.
NEXT_PUBLIC_ILLUSTRATED_MAP=false

# Mapbox — walking/driving directions (https://account.mapbox.com)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase — buildings & researcher data (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — AI assistant chat (server-side only; no NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=
